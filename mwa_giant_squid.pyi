class CsvSubmitError(builtins.Exception):
    r"""
    `AsvoClient.submit_csv_file` submitted the jobs of a file, but some jobs failed.

    The jobs that did not fail were submitted: a failed job does not stop the others. `submitted` has the replies of the jobs that were submitted, and `failures` has one `CsvJobFailure` for each job that was not, both in the order of the file.
    """

    submitted: builtins.list[JobSubmittedResponse]
    r"""
    The replies for the jobs that were submitted, in the order of the file.
    """
    failures: builtins.list[CsvJobFailure]
    r"""
    The jobs that were not submitted, in the order of the file.
    """

class DownloadProgress:
    r"""
    A download progress event, given to the `progress` callback of
    `AsvoClient.download_job` and `AsvoClient.download_obs`.

    For each file there are one or more `Started` events, then zero or more
    `Advanced` events, then one `Finished` event. A second `Started` for the
    same file means that the download started again (for example, the
    server did not honour a resume request), so reset the count. Each
    variant is a subclass, so `isinstance` and `match` work.
    """
    @typing.final
    class Started(DownloadProgress):
        r"""
        A file download starts, or starts again.
        """

        __match_args__ = (
            "job_id",
            "label",
            "total_bytes",
            "position",
        )
        @property
        def job_id(self) -> builtins.int:
            r"""
            The MWA ASVO Job ID.
            """
        @property
        def label(self) -> builtins.str:
            r"""
            A human-readable label, for example `Job ID 123 (Obs ID:
            1234567890) [1/2]:`.
            """
        @property
        def total_bytes(self) -> builtins.int:
            r"""
            The size of the file in bytes.
            """
        @property
        def position(self) -> builtins.int:
            r"""
            The bytes already on disk (not zero for a resumed download).
            """
        def __new__(
            cls, job_id: builtins.int, label: builtins.str, total_bytes: builtins.int, position: builtins.int
        ) -> DownloadProgress.Started: ...

    @typing.final
    class Advanced(DownloadProgress):
        r"""
        `bytes` more bytes were written. Events are combined, so there are
        about 10 a second at most.
        """

        __match_args__ = ("bytes",)
        @property
        def bytes(self) -> builtins.int:
            r"""
            The number of bytes written since the last `Advanced` event.
            """
        def __new__(cls, bytes: builtins.int) -> DownloadProgress.Advanced: ...

    @typing.final
    class Finished(DownloadProgress):
        r"""
        The file download is complete, or was skipped because the file is
        already on disk.
        """

        __match_args__ = ()
        def __new__(cls) -> DownloadProgress.Finished: ...

